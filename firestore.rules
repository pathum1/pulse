rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own surgeon profile
    match /surgeons/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow all authenticated users to read basic surgeon info for calendar
      allow read: if request.auth != null;
    }
    
    // Surgery documents - surgeons can read all, write their own
    match /surgeries/{surgeryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.surgeonId || 
         request.auth.uid == request.resource.data.surgeonId);
    }
    
    // Surgery types - read only for all authenticated users
    match /surgery_types/{typeId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins via server
    }
    
    // Notifications - users can read and write their own
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Check-ins - surgeons can read all, write their own
    match /check_ins/{checkinId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.auth.uid == resource.data.surgeonId;
    }
  }
}